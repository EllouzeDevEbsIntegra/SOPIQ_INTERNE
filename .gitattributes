# Fins de ligne : cmd.exe et PowerShell exigent CRLF, sinon les scripts
# complexes (etiquettes, blocs parentheses) sont mal interpretes.
* text=auto
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
# Le LISEZ-MOI du paquet est ouvert au Bloc-notes sur le poste du client.
*.txt  text eol=crlf
*.sh   text eol=lf
*.json text eol=lf
*.sql  text eol=lf
*.java text eol=lf
*.vue  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
