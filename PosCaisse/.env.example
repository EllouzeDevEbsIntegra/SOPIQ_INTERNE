# ---- PosCaisse — variables d'environnement (copiez en .env ou définissez-les dans START_POS.bat) ----
# PostgreSQL
POSCAISSE_DB_HOST=localhost
POSCAISSE_DB_PORT=5432
POSCAISSE_DB_NAME=poscaisse
POSCAISSE_DB_USER=postgres
POSCAISSE_DB_PASSWORD=postgres
# Backend
POSCAISSE_PORT=8080
# Secret JWT : chaîne aléatoire d'au moins 64 caractères (obligatoire en production)
POSCAISSE_JWT_SECRET=change-me-please-this-is-a-development-secret-key-with-64-bytes-min-length-0123456789
POSCAISSE_JWT_EXPIRATION_MINUTES=720
# Jeu de données de démonstration au premier démarrage (base vide)
POSCAISSE_DEMO_DATA=true
# Origines autorisées (CORS) pour le frontend en mode développement
POSCAISSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Dossier du build frontend servi par le backend (mode production)
POSCAISSE_FRONTEND_DIST=../frontend/dist
