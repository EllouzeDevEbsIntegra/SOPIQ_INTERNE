
.vscode/.alcache/*.*
*.json
*.app

# PosCaisse (Vue + Spring Boot) — re-include its JSON files and ignore build outputs
!PosCaisse/**/*.json
PosCaisse/backend/target/
PosCaisse/frontend/node_modules/
PosCaisse/frontend/dist/
PosCaisse/.env
PosCaisse/logs/
PosCaisse/*.log
PosCaisse/*.pid

# Plateforme : le code vivant, memes regles. Les cartes de demonstration sont du
# JSON versionne - sans cette exception, la regle « *.json » les ferait disparaitre.
!Plateforme/**/*.json
Plateforme/backend/target/
Plateforme/frontend/node_modules/
Plateforme/frontend/dist/
Plateforme/.env
Plateforme/logs/
Plateforme/*.log
Plateforme/*.pid
Plateforme/packaging/dist/
Plateforme/packaging/telechargements/
Plateforme/plateforme/target/
Plateforme/plateforme/frontend/node_modules/
Plateforme/plateforme/frontend/dist/

# Cache de compilation Python : produit en lancant les tests des scripts de
# deploiement (deploiement/tests), jamais du code.
__pycache__/
*.pyc
